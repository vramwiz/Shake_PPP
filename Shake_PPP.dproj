<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{0D4E3867-6594-4D91-9AC8-D2B32FE091FB}</ProjectGuid>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">Shake_PPP</ProjectName>
        <TargetedPlatforms>2</TargetedPlatforms>
        <AppType>Library</AppType>
        <MainSource>Shake_PPP.dpr</MainSource>
        <Base>True</Base>
    </PropertyGroup>
    <PropertyGroup>
        <GenDll>true</GenDll>
        <DCC_DcuOutput>.\$(Platform)\$(Config)\DCU</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
        <SanitizedProjectName>Shake_PPP</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win64)'!=''">
        <Cfg_1_Win64>true</Cfg_1_Win64>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_2)'=='true') or '$(Cfg_2_Win64)'!=''">
        <Cfg_2_Win64>true</Cfg_2_Win64>
        <CfgParent>Cfg_2</CfgParent>
        <Cfg_2>true</Cfg_2>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <GenDll>true</GenDll>
        <SanitizedProjectName>Shake_PPP</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_RemoteDebug>true</DCC_RemoteDebug>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>true</DCC_RangeChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
        <Manifest_File>(なし)</Manifest_File>
        <AppDPIAwarenessMode>none</AppDPIAwarenessMode>
        <DCC_ExeOutput>C:\ProgramData\aviutl2\Plugin\Shake_PPP</DCC_ExeOutput>
        <PreBuildEvent><![CDATA[if not exist "C:\ProgramData\aviutl2\Plugin\Shake_PPP" mkdir "C:\ProgramData\aviutl2\Plugin\Shake_PPP"]]></PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PostBuildEvent><![CDATA[copy /Y "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll" "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).auf2"]]></PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
        <Debugger_HostApplication>D:\aviutl2_v2.1.3a\aviutl2.exe</Debugger_HostApplication>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <BT_BuildType>Release</BT_BuildType>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Win64)'!=''">
        <Manifest_File>(なし)</Manifest_File>
        <AppDPIAwarenessMode>none</AppDPIAwarenessMode>
        <DCC_ExeOutput>C:\ProgramData\aviutl2\Plugin\Shake_PPP</DCC_ExeOutput>
        <PreBuildEvent><![CDATA[if not exist "C:\ProgramData\aviutl2\Plugin\Shake_PPP" mkdir "C:\ProgramData\aviutl2\Plugin\Shake_PPP"]]></PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PostBuildEvent><![CDATA[copy /Y "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll" "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).auf2"&&if exist "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll" del /Q "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll"&&if exist "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).rsm" del /Q "C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).rsm"]]></PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
        <Debugger_HostApplication>D:\aviutl2_v2.1.3a\aviutl2.exe</Debugger_HostApplication>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\Syncroh2\AviUtl\Filter\AviUtl2FilterTypes.pas"/>
        <DCCReference Include="..\Syncroh2\AviUtl\Filter\AviUtl2FilterInfoUtils.pas"/>
        <DCCReference Include="..\Syncroh2\Plugin_Filter\PluginFilterTable.pas"/>
        <DCCReference Include="Source\Lib\Shake_PPP_ToolbarButtons.pas"/>
        <DCCReference Include="Source\Common\Model\Shake_PPP_CurveModel.pas"/>
        <DCCReference Include="Source\Common\Model\Shake_PPP_CurveData.pas"/>
        <DCCReference Include="Source\Common\Settings\Shake_PPP_BulgeSettings.pas"/>
        <DCCReference Include="Source\Common\Settings\Shake_PPP_FilterSettings.pas"/>
        <DCCReference Include="Source\Common\Render\Shake_PPP_CurveRenderer.pas"/>
        <DCCReference Include="Source\Common\Render\Shake_PPP_BulgeDeformer.pas"/>
        <DCCReference Include="Source\Common\Render\Shake_PPP_GpuBulgeDeformer.pas"/>
        <DCCReference Include="Source\Common\Render\Shake_PPP_StaticDeformer.pas"/>
        <DCCReference Include="Source\Common\Render\Shake_PPP_RuntimeDeformer.pas"/>
        <DCCReference Include="Source\Common\Diagnostics\Shake_PPP_DebugLog.pas"/>
        <DCCReference Include="Source\Common\Render\Shake_PPP_LastFrameCapture.pas"/>
        <DCCReference Include="Source\Plugin\Filter\Shake_PPP_SettingsForm.pas">
            <Form>FormShakeSettings</Form>
        </DCCReference>
        <DCCReference Include="Source\Plugin\Filter\Shake_PPP_FilterPlugin.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Shake_PPP.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">False</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
    <PropertyGroup Condition="'$(Config)'=='Debug' And '$(Platform)'=='Win64'">
        <PreBuildEvent>if not exist &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP&quot; mkdir &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP&quot;</PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PreLinkEvent/>
        <PreLinkEventIgnoreExitCode>False</PreLinkEventIgnoreExitCode>
        <PostBuildEvent>copy /Y &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll&quot; &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).auf2&quot;</PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' And '$(Platform)'=='Win64'">
        <PreBuildEvent>if not exist &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP&quot; mkdir &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP&quot;</PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PreLinkEvent/>
        <PreLinkEventIgnoreExitCode>False</PreLinkEventIgnoreExitCode>
        <PostBuildEvent>copy /Y &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll&quot; &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).auf2&quot;&amp;&amp;if exist &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll&quot; del /Q &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).dll&quot;&amp;&amp;if exist &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).rsm&quot; del /Q &quot;C:\ProgramData\aviutl2\Plugin\Shake_PPP\$(PROJECTNAME).rsm&quot;</PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
