[
  {
    "id": "VRAMWIZ.Shake_PPP",
    "name": "胸揺れ",
    "type": "フィルタプラグイン",
    "summary": "画像の一部分をオブジェクト移動に合わせて柔らかく揺らすフィルター",
    "description": "https://raw.githubusercontent.com/vramwiz/Shake_PPP/main/README.md",
    "author": "VRAMの魔術師",
    "repoURL": "https://github.com/vramwiz/Shake_PPP",
    "licenses": [
      {
        "type": "不明",
        "isCustom": true,
        "copyrights": [],
        "licenseBody": ""
      }
    ],
    "tags": [
      "揺れ",
      "変形",
      "ベジェ曲線"
    ],
    "dependencies": [],
    "images": [],
    "installer": {
      "source": {
        "direct": null,
        "booth": null,
        "GoogleDrive": null,
        "github": {
          "owner": "vramwiz",
          "repo": "Shake_PPP",
          "pattern": "^Shake_PPP\\.zip$"
      }
      },
      "install": [
        {
          "action": "download"
        },
        {
          "action": "extract"
        },
        {
          "action": "copy",
          "from": "{tmp}/Shake_PPP",
          "to": "{pluginsDir}/Shake_PPP"
        }
      ],
      "uninstall": [
        {
          "action": "delete",
          "path": "{pluginsDir}/Shake_PPP"
        }
      ]
    },
    "version": []
  }
]
